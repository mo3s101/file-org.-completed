// ==========================================
// Task 6: Remove a grade from grades.txt
// ==========================================
void task6()
{
    fstream file, temp;

    file.open("grades.txt", ios::in);
    temp.open("temp_grades.txt", ios::out);

    if (!file.good() || !temp.good())
    {
        cout << "Error opening files!" << endl;
        if (file.is_open())
            file.close();
        if (temp.is_open())
            temp.close();
        return;
    }

    int grade;
    while (file >> grade)
    {
        cout << grade << endl;
    }

    if (file.bad())
    {
        cout << "Serious reading error!" << endl;
        file.close();
        temp.close();
        remove("temp_grades.txt");
        return;
    }

    if (!file.eof())
    {
        cout << "Reading failed!" << endl;
        file.close();
        temp.close();
        remove("temp_grades.txt");
        return;
    }

    file.clear();
    file.seekg(0, ios::beg);

    bool found = false;
    int temp_grade;

    cout << "Enter the grade you want to remove: ";
    cin >> temp_grade;

    while (file >> grade)
    {
        if (temp_grade != grade || found)
        {
            temp << grade << endl;
        }
        else
        {
            found = true;
        }
    }

    if (!temp.good())
    {
        cout << "Writing failed!" << endl;
        file.close();
        temp.close();
        remove("temp_grades.txt");
        return;
    }

    temp.close();
    file.close();

    if (found)
    {
        if (remove("grades.txt") == 0 &&
            rename("temp_grades.txt", "grades.txt") == 0)
        {
            cout << "Grade deleted successfully!" << endl;
        }
        else
        {
            cout << "Error replacing file!" << endl;
        }
    }
    else
    {
        remove("temp_grades.txt");
        cout << "Grade not found!" << endl;
    }
}

// ==========================================
// Task 7: Sort names in name.txt
// ==========================================
void task7()
{
    vector<string> names;
    fstream file;

    file.open("name.txt", ios::in);
    if (!file.is_open())
    {
        cout << "Error opening name.txt!" << endl;
        return;
    }

    string name;
    while (getline(file, name))
    {
        names.push_back(name);
    }
    file.close();

    file.open("name.txt", ios::trunc | ios::out);
    sort(names.begin(), names.end());

    while (!names.empty())
    {
        file << names.front() << endl;
        names.erase(names.begin());
    }
    file.close();

    cout << "the task compleet succesfully" << endl;
}


// Helper function to clear input buffer before getline
void clearBuffer()
{
    cin.ignore(numeric_limits<streamsize>::max(), '\n');
}

// ==========================================
// Task 1: Student data -> Student.txt
// ==========================================
void task1()
{
    string fullName;
    int id;
    float grade;

    clearBuffer();
    cout << "Enter Full Name: ";
    getline(cin, fullName);

    cout << "Enter ID: ";
    cin >> id;

    cout << "Enter Grade: ";
    cin >> grade;

    ofstream outFile("Student.txt");
    if (!outFile)
    {
        cout << "Error creating Student.txt!\n";
        return;
    }

    outFile << "Full Name: " << fullName << "\n";
    outFile << "ID: " << id << "\n";
    outFile << "Grade: " << grade << "\n";
    outFile.close();

    cout << "Student data saved to Student.txt successfully.\n";
}

// ==========================================
// Task 2: Read fruit.txt & append "Fresh Fruits"
// ==========================================
void task2()
{
    ifstream checkFile("fruit.txt");
    if (!checkFile.good())
    {
        ofstream createFruit("fruit.txt");
        createFruit << "Apple\nOrange\nBanana\n";
        createFruit.close();
    }
    checkFile.close();

    ifstream inFile("fruit.txt");
    if (!inFile)
    {
        cout << "Error opening fruit.txt for reading!\n";
        return;
    }

    cout << "--- Contents of fruit.txt ---\n";
    string line;
    while (getline(inFile, line))
    {
        cout << line << "\n";
    }
    inFile.close();

    ofstream appendFile("fruit.txt", ios::app);
    if (!appendFile)
    {
        cout << "Error opening fruit.txt for appending!\n";
        return;
    }

    appendFile << "Fresh Fruits\n";
    appendFile.close();

    cout << "\"Fresh Fruits\" appended to fruit.txt successfully.\n";
}

// ==========================================
// Task 3: welcome.txt -> replace "body" with "one"
// ==========================================
void task3()
{
    ofstream outFile("welcome.txt");
    if (!outFile)
    {
        cout << "Error creating welcome.txt!\n";
        return;
    }
    outFile << "Hello Everybody";
    outFile.close();

    ifstream inFile("welcome.txt");
    string content;
    getline(inFile, content);
    inFile.close();

    string target = "body";
    string replacement = "one";
    size_t pos = content.find(target);

    if (pos != string::npos)
    {
        content.replace(pos, target.length(), replacement);
    }

    ofstream updateFile("welcome.txt");
    updateFile << content << "\n";
    updateFile.close();

    cout << "Updated sentence written to welcome.txt: " << content << "\n";
}

// ==========================================
// Task 4 (Lab 1): Persons, vector, younger & older
// ==========================================
struct Person
{
    string name;
    int age;
};

void task4()
{
    int n;
    cout << "How many persons do you want to add? ";
    cin >> n;

    if (n <= 0)
    {
        cout << "Invalid number of persons.\n";
        return;
    }

    ofstream outFile("persons.txt");
    if (!outFile)
    {
        cout << "Error creating persons.txt!\n";
        return;
    }

    for (int i = 0; i < n; i++)
    {
        string name;
        int age;

        clearBuffer();
        cout << "Person " << (i + 1) << " Name: ";
        getline(cin, name);

        cout << "Person " << (i + 1) << " Age: ";
        cin >> age;

        outFile << name << " " << age << "\n";
    }
    outFile.close();

    vector<Person> persons;
    ifstream inFile("persons.txt");
    if (!inFile)
    {
        cout << "Error opening persons.txt!\n";
        return;
    }

    Person temp;
    while (inFile >> temp.name >> temp.age)
    {
        persons.push_back(temp);
    }
    inFile.close();

    if (persons.empty())
    {
        cout << "No person records found in file.\n";
        return;
    }

    int minAge = persons[0].age;
    int maxAge = persons[0].age;

    for (size_t i = 1; i < persons.size(); i++)
    {
        if (persons[i].age < minAge)
            minAge = persons[i].age;
        if (persons[i].age > maxAge)
            maxAge = persons[i].age;
    }

    ofstream resFile("results.txt");
    if (!resFile)
    {
        cout << "Error creating results.txt!\n";
        return;
    }

    resFile << "Younger Person(s) (Age: " << minAge << "):\n";
    for (const auto &p : persons)
    {
        if (p.age == minAge)
        {
            resFile << "- " << p.name << " (" << p.age << ")\n";
        }
    }

    resFile << "\nOlder Person(s) (Age: " << maxAge << "):\n";
    for (const auto &p : persons)
    {
        if (p.age == maxAge)
        {
            resFile << "- " << p.name << " (" << p.age << ")\n";
        }
    }
    resFile.close();

    cout << "Results saved to results.txt successfully.\n";
}


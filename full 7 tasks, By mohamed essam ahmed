void task5()
{
    ofstream outFile("students.txt", ios::app);
    if (!outFile)
    {
        cout << "Error opening students.txt!\n";
        return;
    }

    char choice = 'y';
    while (choice == 'y' || choice == 'Y')
    {
        StudentRecord rec;
        rec.delim = '$';

        clearBuffer();
        cout << "Enter Student Name (max 19 chars): ";
        cin.getline(rec.name, 20);

        cout << "Enter ID: ";
        cin >> rec.id;

        cout << "Enter Grade: ";
        cin >> rec.grade;

        outFile << rec.name << ", " << rec.id << ", " << rec.grade << " " << rec.delim << "\n";

        cout << "Add another student? (y/n): ";
        cin >> choice;
    }

    outFile.close();
    cout << "Student records saved to students.txt.\n";
